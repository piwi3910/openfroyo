# OpenFroyo Agent Configuration
# Generated by OpenFroyo agent onboarding stack

# Agent identification
agent:
  # Unique agent ID (defaults to hostname if not specified)
  id: "{{ inventory_hostname }}"

  # Datacenter location
  datacenter: "{{ datacenter }}"

  # Agent version
  version: "{{ agent_version }}"

  # Tags for agent classification
  tags:
    - "{{ datacenter }}"
    - "{{ inventory_hostname }}"

# NATS connection settings
nats:
  # NATS server URL(s)
  servers:
    - "{{ nats_server }}"

  # Subject prefix for this datacenter
  subject_prefix: "openfroyo.{{ datacenter }}"

  # Connection options
  connection:
    # Maximum reconnection attempts
    max_reconnects: -1  # Infinite

    # Reconnect wait time (seconds)
    reconnect_wait: 2

    # Connection timeout (seconds)
    timeout: 5

    # Ping interval (seconds)
    ping_interval: 20

    # Max pings outstanding
    max_pings_out: 2

# Execution settings
execution:
  # Working directory for module execution
  work_dir: /var/lib/froyo/work

  # Module cache directory
  module_cache: /var/lib/froyo/modules

  # Maximum concurrent tasks
  max_concurrent: 5

  # Task timeout (seconds)
  task_timeout: 300

# Logging configuration
logging:
  # Log level (debug, info, warn, error)
  level: info

  # Log file location
  file: /var/log/froyo/agent.log

  # Max log file size (MB)
  max_size: 100

  # Max log files to keep
  max_backups: 5

  # Max age of log files (days)
  max_age: 30

  # Compress old log files
  compress: true

# Pull mode settings
pull:
  # Enable pull mode (periodic stack execution)
  enabled: true

  # Poll interval for new tasks (seconds)
  interval: 60

  # Stacks to execute periodically
  stacks:
    # Example: Ensure compliance every 5 minutes
    - name: compliance-check
      interval: 300
      enabled: true

    # Example: Security updates check hourly
    - name: security-updates
      interval: 3600
      enabled: true

# Security settings
security:
  # Enable TLS for NATS connection
  tls:
    enabled: false
    # cert_file: /etc/froyo/tls/agent.crt
    # key_file: /etc/froyo/tls/agent.key
    # ca_file: /etc/froyo/tls/ca.crt

  # Enable authentication
  auth:
    enabled: false
    # token: ""
    # credentials_file: /etc/froyo/nats.creds
