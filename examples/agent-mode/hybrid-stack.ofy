name: Hybrid Mode Example Stack
description: Demonstrates executing tasks on both SSH and agent-based hosts

inventory:
  - inventory.yml

defaults:
  message: "Hello from OpenFroyo!"

run:
  # Task 1: Execute on push mode host (admin-server)
  - name: Create file on push mode host
    module: generic/file
    hosts:
      - admin-server
    vars:
      path: /tmp/openfroyo-push.txt
      state: touch
      mode: '0644'

  # Task 2: Execute on pull mode hosts (web-01, web-02)
  - name: Create file on pull mode hosts
    module: generic/file
    hosts:
      - web-01
      - web-02
    vars:
      path: /tmp/openfroyo-pull.txt
      state: touch
      mode: '0644'

  # Task 3: Execute on all webservers (both pull mode hosts)
  - name: Install nginx on webservers
    module: linux/package
    hosts:
      - @group:webservers
    vars:
      name: nginx
      state: present

  # Task 4: Hybrid execution (push + pull modes)
  - name: Check system info on all hosts
    module: generic/command
    hosts:
      - admin-server
      - web-01
      - web-02
      - db-server
    vars:
      cmd: uname -a
