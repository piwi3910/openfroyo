---
# Test stack for ping module

inventory:
  hosts:
    - localhost

defaults:
  ansible_connection: local

run:
  # Test 1: Basic ping to Google DNS
  - task: Ping Google DNS (8.8.8.8)
    module: ping
    vars:
      host: 8.8.8.8
      count: 3
      timeout: 5

  # Test 2: Ping a hostname
  - task: Ping google.com
    module: ping
    vars:
      host: google.com
      count: 4

  # Test 3: Ping with minimal packets
  - task: Quick ping test
    module: ping
    vars:
      host: 1.1.1.1
      count: 1
      timeout: 2

  # Test 4: IPv6 ping (if supported)
  - task: Ping Cloudflare IPv6 DNS
    module: ping
    vars:
      host: 2606:4700:4700::1111
      count: 2
      timeout: 5
