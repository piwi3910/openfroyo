# Test file for idrac module - Power Management
name: iDRAC Power Management Test
inventory: ../../../inventory/hosts.yml

defaults:
  baseuri: "192.168.1.100"
  username: "root"
  password: "calvin"
  validate_certs: false

run:
  - name: Check power state
    module: idrac
    vars:
      command: "get_power_state"

  - name: Power on server
    module: idrac
    vars:
      command: "power_on"
