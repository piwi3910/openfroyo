  #     user_privilege: "3"
  #
  # - name: Enable user
  #   module: servers/ipmi
  #   vars:
  #     bmc_host: "{{ defaults.bmc_host }}"
  #     username: "{{ defaults.username }}"
  #     password: "{{ defaults.password }}"
  #     command: "enable_user"
  #     user_id: 3

  # LAN Configuration Examples (COMMENTED OUT - MODIFIES NETWORK)
  #
  # - name: Set static IP address
  #   module: servers/ipmi
  #   vars:
  #     bmc_host: "{{ defaults.bmc_host }}"
  #     username: "{{ defaults.username }}"
  #     password: "{{ defaults.password }}"
  #     command: "set_lan_ip_static"
  #     channel: 1
  #     ip_address: "192.168.1.101"
  #     subnet_mask: "255.255.255.0"
  #     gateway: "192.168.1.1"
  #
  # - name: Set DHCP
  #   module: servers/ipmi
  #   vars:
  #     bmc_host: "{{ defaults.bmc_host }}"
  #     username: "{{ defaults.username }}"
  #     password: "{{ defaults.password }}"
  #     command: "set_lan_ip_dhcp"
  #     channel: 1
  #
  # - name: Set VLAN
  #   module: servers/ipmi
  #   vars:
  #     bmc_host: "{{ defaults.bmc_host }}"
  #     username: "{{ defaults.username }}"
  #     password: "{{ defaults.password }}"
  #     command: "set_lan_vlan"
  #     channel: 1
  #     vlan_id: 100

  # SEL Management Examples (COMMENTED OUT - MODIFIES SEL)
  #
  # - name: Save SEL to file
  #   module: servers/ipmi
  #   vars:
  #     bmc_host: "{{ defaults.bmc_host }}"
